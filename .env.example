# Port for the HTTP server (agent range 3300-3399 for local dev)
PORT=3300
# Required: secret for /admin/* endpoints. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-string
# SQLite file path (node:sqlite). Use ":memory:" for throwaway runs.
DB_PATH=./data/og.db
# Public base URL, shown in the landing page examples
PUBLIC_URL=http://localhost:3300
